# 开发环境配置

# 应用部署域名（部署后对外访问的地址，nginx 服务地址）
VITE_APP_DEPLOY_BASE_URL=http://localhost

# 应用生成预览域名（预览 AI 生成的应用，走后端静态资源接口）
VITE_APP_PREVIEW_BASE_URL=/api/static

# 站点信息（个人信息不进仓库，按需在本地覆盖；线上由 CI 变量注入，见 .github/workflows/deploy.yml）
# VITE_SITE_NAME=             # 站点名称，默认 CodeSpark AI
# VITE_SITE_URL=              # 站点访问地址（页脚站点链接）
# VITE_WEBMASTER_NAME=        # 站长名称（留空则页脚不展示）
# VITE_WEBMASTER_URL=         # 站长主页链接
# VITE_CONTACT_EMAIL=         # 联系邮箱（留空则协议页面不展示）
# VITE_ICP_NUMBER=            # ICP 备案号（留空则页脚不展示）
# VITE_ICP_URL=               # ICP 备案查询链接，默认 https://beian.miit.gov.cn/
# VITE_GA_BEIAN_NUMBER=       # 公安备案号（留空则页脚不展示，查询链接从备案号自动生成）
# VITE_GA_BEIAN_ICON=         # 公安备案标识图片 URL（留空则仅展示文字）
# VITE_GA_BEIAN_URL=          # 公安备案查询链接，默认根据备案号自动生成
