# 生产环境配置

# 应用部署域名（部署后对外访问的地址，nginx 服务地址）
VITE_APP_DEPLOY_BASE_URL=https://codespark.littlewin.top

# 应用生成预览域名（预览 AI 生成的应用，走后端静态资源接口）
VITE_APP_PREVIEW_BASE_URL=/api/static

# 站点信息（个人信息不进仓库；仓库内不填，由 GitHub Actions 变量在构建时注入，见 .github/workflows/deploy.yml）
# VITE_SITE_NAME=
# VITE_SITE_URL=
# VITE_WEBMASTER_NAME=
# VITE_WEBMASTER_URL=
# VITE_CONTACT_EMAIL=
# VITE_ICP_NUMBER=
# VITE_ICP_URL=
# VITE_GA_BEIAN_NUMBER=
# VITE_GA_BEIAN_ICON=
# VITE_GA_BEIAN_URL=
