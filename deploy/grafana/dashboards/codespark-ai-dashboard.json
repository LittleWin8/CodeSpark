{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "CodeSpark AI 模型监控",
  "uid": "codespark-ai",
  "tags": ["codespark", "ai"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "model_name",
        "type": "query",
        "label": "模型",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(ai_model_requests_total, model_name)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 1,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "title": "累计请求数",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ai_model_requests_total{status=\"started\",model_name=~\"$model_name\"})",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 101,
      "title": "累计 Token 总量",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ai_model_tokens_total{token_type=\"total\",model_name=~\"$model_name\"})",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 102,
      "title": "累计错误数",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ai_model_errors_total{model_name=~\"$model_name\"}) or vector(0)",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 103,
      "title": "范围成功率",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ai_model_requests_total{status=\"success\",model_name=~\"$model_name\"}[$__range])) / sum(increase(ai_model_requests_total{status=~\"success|error\",model_name=~\"$model_name\"}[$__range]))",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 104,
      "title": "范围 Token 消耗",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ai_model_tokens_total{token_type=\"total\",model_name=~\"$model_name\"}[$__range]))",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 105,
      "title": "范围 p95 延迟",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0 },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(increase(ai_model_response_duration_seconds_bucket{model_name=~\"$model_name\"}[$__range])) by (le))",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 1,
      "title": "请求量趋势（started，每步时间段内请求数）",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["sum", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model_name) (increase(ai_model_requests_total{status=\"started\",model_name=~\"$model_name\"}[$__rate_interval]))",
          "legendFormat": "{{model_name}}",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Token 消耗趋势（total，每步时间段内消耗量）",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["sum", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (token_type) (increase(ai_model_tokens_total{token_type=~\"input|output\",model_name=~\"$model_name\"}[$__rate_interval]))",
          "legendFormat": "{{token_type}}",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Token 按模型分组（total，每步时间段内消耗量）",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["sum", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model_name) (increase(ai_model_tokens_total{token_type=\"total\",model_name=~\"$model_name\"}[$__rate_interval]))",
          "legendFormat": "{{model_name}}",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "title": "响应延迟 p50/p95/p99",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0 },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum(increase(ai_model_response_duration_seconds_bucket{model_name=~\"$model_name\"}[$__rate_interval])) by (le))",
          "legendFormat": "p50",
          "range": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(increase(ai_model_response_duration_seconds_bucket{model_name=~\"$model_name\"}[$__rate_interval])) by (le))",
          "legendFormat": "p95",
          "range": true
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum(increase(ai_model_response_duration_seconds_bucket{model_name=~\"$model_name\"}[$__rate_interval])) by (le))",
          "legendFormat": "p99",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Top 用户 Token 排行（累计 total）",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": [
          { "matcher": { "id": "byName", "options": "user_id" }, "properties": [{ "id": "displayName", "value": "用户ID" }] },
          { "matcher": { "id": "byName", "options": "user_account" }, "properties": [{ "id": "displayName", "value": "用户账号" }] },
          { "matcher": { "id": "byName", "options": "Value" }, "properties": [{ "id": "displayName", "value": "Token 消耗总量" }] }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Token 消耗总量", "desc": true }]
      },
      "transformations": [
        { "id": "organize", "options": { "renameByName": { "user_id": "用户ID", "user_account": "用户账号", "Value": "Token 消耗总量" }, "indexByName": {} } }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (user_id, user_account) (ai_model_tokens_total{token_type=\"total\",model_name=~\"$model_name\"}))",
          "legendFormat": "{{user_account}}",
          "format": "table",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 7,
      "title": "错误趋势（每步时间段内错误数，按 error_type）",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["sum", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (error_type) (increase(ai_model_errors_total{model_name=~\"$model_name\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "{{error_type}}",
          "range": true
        }
      ]
    }
  ]
}
